# 复制为 .env.teacher 后填写；真实 secret 不得提交或写入日志。
TEACHER_API_URL=
TEACHER_API_KEY=
TEACHER_API_MODEL=
TEACHER_API_STYLE=chat_completions
TEACHER_REASONING_EFFORT=high

# Optional numbered profiles: each selected profile requires all five fields.
# No fallback to unnumbered settings when using --api-workers.
