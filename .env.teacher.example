# 复制为 .env.teacher 后填写；真实 secret 不得提交或写入日志。
TEACHER_API_URL=
TEACHER_API_KEY=
TEACHER_API_MODEL=
TEACHER_API_STYLE=chat_completions
TEACHER_REASONING_EFFORT=high

# Optional numbered profiles: used only with --api-workers 1:8,2:12.
# Shared MODEL / REASONING_EFFORT above still apply. Numbered STYLE overrides shared STYLE.
# TEACHER_API_URL_1=
# TEACHER_API_KEY_1=
# TEACHER_API_STYLE_1=chat_completions
# TEACHER_API_URL_2=
# TEACHER_API_KEY_2=
# TEACHER_API_STYLE_2=responses
# TEACHER_API_URL_3=
# TEACHER_API_KEY_3=
# TEACHER_API_STYLE_3=chat_completions
